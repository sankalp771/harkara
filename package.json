{
  "name": "harkara",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable webhook delivery for Node/TypeScript apps using their existing Postgres. The Sidekiq of webhooks.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "test": "vitest run"
  },
  "dependencies": {
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0",
    "standardwebhooks": "^1.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
